# ─────────────────────────────────────────────────────────────
# .env.example racine — frontend (Vite)
# Pour le backend, voir backend/.env.example
# ─────────────────────────────────────────────────────────────

# EmailJS — formulaire de contact public
# Compte : https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Cible du proxy de dev Vite vers le backend Express
# Optionnel — défaut http://localhost:3000
# VITE_API_PROXY_TARGET=http://localhost:3000
