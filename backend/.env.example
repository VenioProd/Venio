# ============================================================================
# Venio backend - environment variables example
# Copy this file to backend/.env and fill the placeholders.
# Variables marked REQUIRED are enforced by backend/src/lib/requireEnv.ts
# and the server will refuse to boot if they are missing.
# ============================================================================

# ----------------------------------------------------------------------------
# Core / runtime
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ----------------------------------------------------------------------------
# Database (REQUIRED)
# ----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/venio
# Legacy alias still read by some maintenance scripts. Prefer MONGODB_URI.
# MONGO_URI=mongodb://localhost:27017/venio

# ----------------------------------------------------------------------------
# Auth / crypto (REQUIRED)
# ----------------------------------------------------------------------------
# JWT signing secret. Generate with: openssl rand -base64 48
JWT_SECRET=change_me_please_use_a_long_random_string
JWT_EXPIRES_IN=7d
# AES-256 key (32 bytes, base64 or hex). Used to encrypt sensitive fields
# at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change_me_32_byte_base64_key

# Super Admin bootstrap (created on first start if no admin exists)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_me
SUPER_ADMIN_NAME=Admin

# ----------------------------------------------------------------------------
# Networking / CORS
# ----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5501
# Public URLs referenced in emails and admin links.
APP_NAME=Venio
APP_URL=http://localhost:5501
FRONTEND_URL=http://localhost:5501
CLIENT_URL=http://localhost:5501
CRM_URL=http://localhost:5501
ADMIN_LOGIN_URL=http://localhost:5501/admin/login

# ----------------------------------------------------------------------------
# Email (SMTP)
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Venio <no-reply@venio.paris>"
# Address that receives contact form submissions.
TARGET_EMAIL=contact@venio.paris

# ----------------------------------------------------------------------------
# Nextcloud (client folder provisioning + storage)
# Generate an app password: Nextcloud > Settings > Security > App passwords.
# ----------------------------------------------------------------------------
NEXTCLOUD_URL=https://votre-nextcloud.example.com
NEXTCLOUD_USER=admin
NEXTCLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
NEXTCLOUD_BASE_PATH=/Venio/Clients
# Admin credentials used for provisioning calls (user creation, quotas).
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASS=

# ----------------------------------------------------------------------------
# Web Push (PWA notifications)
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# ----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@venio.paris

# ----------------------------------------------------------------------------
# Education space - Apple Calendar (read-only ICS feed)
# Get the URL in Apple Calendar > right-click on the calendar > Sharing >
# Public calendar. NEVER COMMIT the URL: it is unauthenticated.
# ----------------------------------------------------------------------------
EDUCATION_APPLE_CALENDAR_ICS_URL=
# Optional in-memory cache TTL in ms (default 900_000 = 15 min).
EDUCATION_APPLE_CALENDAR_TTL_MS=
# Legacy alias kept for backwards compatibility.
# APPLE_CALENDAR_ICS_URL=

# ----------------------------------------------------------------------------
# Accounting
# ----------------------------------------------------------------------------
# Number of days after which a VALIDATED entry auto-locks (immutable).
# Set to 0 to disable.
ACCOUNTING_LOCK_VALIDATED_AFTER_DAYS=30
# Embed Factur-X XML inside generated invoice PDFs.
FACTUR_X_ENABLED=true

# ----------------------------------------------------------------------------
# Dev tooling / internal projects module
# ----------------------------------------------------------------------------
# Default repository path used by the project recommender CLI integration.
DEV_DEFAULT_REPO_PATH=
# Root directory under which internal repos can be discovered.
DEV_REPO_ROOT=

# ----------------------------------------------------------------------------
# Backups (file storage rotation)
# ----------------------------------------------------------------------------
BACKUP_DIR=./backups
MAX_BACKUPS=14

# ----------------------------------------------------------------------------
# Maintenance flags - DO NOT enable in normal runs
# ----------------------------------------------------------------------------
# Required (with NODE_ENV=production) to allow backend/scripts/cleanup-prod.ts
# to wipe demo data. Set explicitly per run, never in a long-lived .env.
ALLOW_DEMO_CLEANUP=
# Alias used by the cleanup guard.
# ALLOW_CLEANUP=
