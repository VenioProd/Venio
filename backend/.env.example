PORT=3000
MONGODB_URI=mongodb://localhost:27017/venio
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5501

# Super Admin bootstrap (created on first start if no admin exists)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_me
SUPER_ADMIN_NAME=Admin

# Nextcloud (création automatique de dossiers clients)
# Générer un mot de passe d'application : Nextcloud > Paramètres > Sécurité > Mots de passe d'application
NEXTCLOUD_URL=https://votre-nextcloud.example.com
NEXTCLOUD_USER=admin
NEXTCLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
NEXTCLOUD_BASE_PATH=/Venio/Clients

# --- Comptabilité ---
ACCOUNTING_DEFAULT_REGIME=REEL_NORMAL
ACCOUNTING_DEFAULT_VAT_PERIODICITY=MENSUEL
# Nombre de jours après validation au-delà duquel une écriture VALIDATED bascule
# automatiquement en LOCKED (immutable). Mettre 0 pour désactiver.
ACCOUNTING_LOCK_VALIDATED_AFTER_DAYS=30
# Active l'embed XML Factur-X dans les PDF de facture
FACTUR_X_ENABLED=true
# Rate limit ingestion externe (par source, par minute) — surchargeable par source
EXTERNAL_INGEST_RATE_LIMIT_PER_MIN=60
EXTERNAL_API_KEY_PREFIX=vno_live_
